# Copy to .env.production and replace every placeholder before deployment.

ENVIRONMENT=production
DEBUG=false
VENUE_TYPE=commercial
VENUE_NAME=Production Venue

DATABASE_URL=postgresql://security_user:change_me@postgres:5432/security_system
POSTGRES_USER=security_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=security_system

REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

ADMIN_EMAIL=security@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=change_me
ALERT_WEBHOOK_URL=

API_PORT=3000
API_AUTH_ENABLED=true
API_KEYS=token-one,token-two
CORS_ORIGIN=https://security.example.com
TRUST_PROXY=1

ALERT_DISPATCHER_URL=http://alert_dispatcher:8080
CAMERA_STREAMER_URL=http://camera_streamer:8081

CAMERA_STALL_SECONDS=10
MAX_CONSECUTIVE_READ_FAILURES=5
ALERT_COOLDOWN_SECONDS=60
