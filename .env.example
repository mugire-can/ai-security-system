# ============================================================================
# AI SECURITY CAMERA SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env
# The .env file is git-ignored and must NEVER be committed to version control!
# ============================================================================

# VENUE CONFIGURATION
# ============================================================================
VENUE_TYPE=school                          # Options: school, commercial, workplace
VENUE_NAME=My Secure Venue
DEBUG=false                                # Enable debug logging
LOG_LEVEL=INFO                             # Options: DEBUG, INFO, WARNING, ERROR

# CAMERA / DETECTION CONFIGURATION
# ============================================================================
# YOLOv8 Model (auto-downloaded on first run)
YOLO_MODEL=yolov8n.pt                      # Options: yolov8n(nano), yolov8s(small), yolov8m(medium), yolov8l(large), yolov8x(xlarge)

# Detection Thresholds
PERSON_CONFIDENCE_THRESHOLD=0.55            # Min confidence (0.0-1.0) to report person
BEHAVIOUR_CONFIDENCE_THRESHOLD=0.65         # Min confidence for behavior classification

# Analysis Settings
ANALYSIS_FRAME_INTERVAL=5                  # Analyze every Nth frame (higher=faster, less accurate)
LOITERING_THRESHOLD_SECONDS=120            # Alert if person loiters >2 minutes
ANOMALY_CONSECUTIVE_FRAMES=10              # Frames until anomaly alert triggers
CAMERA_STALL_SECONDS=10                    # Raise live health alert if a feed stops updating
MAX_CONSECUTIVE_READ_FAILURES=5            # Mark a camera degraded after repeated frame-read errors

# Custom CV labels
# If you use a custom YOLO model, labels like fire, smoke, water_leak,
# electrical_spark, knife, gun, fallen_person, or person_down are mapped
# to facility-fault / threat / accident alerts automatically.

# Face Recognition
FACE_RECOGNITION_TOLERANCE=0.5             # Lower = stricter matching (0.0-1.0)

# ATTENDANCE & TIME TRACKING CONFIGURATION
# ============================================================================
KNOWN_FACES_DIR=data/known_faces           # Directory with registered face images (see SETUP_GUIDE)
WORK_START_TIME=08:00                      # Expected check-in time (HH:MM format)
WORK_END_TIME=18:00                        # Expected check-out time (HH:MM format)
REPORTS_DIR=data/reports                   # Location for CSV attendance exports

# DATABASE CONFIGURATION
# ============================================================================
# SQLite (Development - default, no setup required):
DATABASE_URL=sqlite:///data/security_system.db

# PostgreSQL (Production - requires server setup):
# DATABASE_URL=postgresql://user:password@localhost:5432/security_system

# Redis Cache (Optional - for production high-volume deployments):
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ADMIN ALERT & NOTIFICATION CONFIGURATION
# ============================================================================
# Alert Recipient
ADMIN_EMAIL=admin@yourdomain.com           # Primary alert recipient email

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com                   # SMTP server address
SMTP_PORT=587                              # TLS port (usually 587 or 25)
SMTP_USER=your-email@gmail.com             # SMTP username/email
SMTP_PASSWORD=your-app-password            # Use Gmail app-specific password (not regular password!)

# Webhook Configuration (Slack, Teams, Discord, etc.)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# For Microsoft Teams: https://outlook.webhook.office.com/webhookb2/...
# For Discord: https://discord.com/api/webhooks/...
# Leave empty to disable webhook alerts

# Alert Cooldown (Prevent spam/duplicate alerts)
ALERT_COOLDOWN_SECONDS=60                  # Min seconds between same alert on same person/zone

# SERVICE CONFIGURATION (Multi-Language Services)
# ============================================================================
GO_ALERT_DISPATCHER_PORT=8080              # Go alert dispatcher service
GO_CAMERA_STREAMER_PORT=8081               # Go camera management service
TYPESCRIPT_API_PORT=3000                   # TypeScript REST API gateway
RUST_VIDEO_OPTIMIZER_PORT=8082             # Rust video processing service
API_HOST=0.0.0.0                           # API bind address
API_AUTH_ENABLED=false                     # Set true to require API keys for non-health API routes
API_KEYS=                                  # Comma-separated bearer/API keys for the TypeScript API
CORS_ORIGIN=*                              # Use a specific origin in production
TRUST_PROXY=0                              # Set to 1 behind a reverse proxy/load balancer

# DOCKER & CONTAINER CONFIGURATION
# ============================================================================
DOCKER_BUILD_CONTEXT=.
COMPOSE_PROJECT_NAME=ai-security-system

# PostgreSQL Container (if using Docker deployment)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_secure_password
POSTGRES_DB=security_system
POSTGRES_PORT=5432

# Redis Container (if using Docker deployment)
REDIS_PORT=6379

# FEATURE FLAGS
# ============================================================================
ENABLE_EMAIL_ALERTS=true                   # Send email notifications
ENABLE_WEBHOOK_ALERTS=true                 # Send webhook notifications (Slack, Teams)
ENABLE_DASHBOARD=true                      # Enable terminal UI dashboard
ENABLE_FACE_RECOGNITION=true               # Enable attendance tracking via face recognition
ENABLE_BEHAVIOR_ANALYSIS=true              # Enable suspicious behavior detection
ENABLE_ANOMALY_DETECTION=true              # Enable detection of animals, vehicles, unattended objects
ENABLE_EMOTION_ANALYSIS=true               # Enable emotion recognition (happy, angry, sad, etc.)

# PERFORMANCE TUNING
# ============================================================================
MAX_WORKERS=4                               # Number of CPU processing workers
QUEUE_SIZE=100                              # Maximum pending alerts in queue
CACHE_TTL=3600                              # Cache duration in seconds
BATCH_SIZE=32                               # Frame batch processing size

# MISCELLANEOUS
# ============================================================================
TIMEZONE=UTC                                # Server timezone (timezone name)
LOCALE=en_US                                # Locale for date/time formatting
ENVIRONMENT=development                    # Options: development, staging, production

# GMAIL SETUP INSTRUCTIONS
# ============================================================================
# 1. Enable 2-step verification in Gmail account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password above (spaces can be removed)
# 4. Replace SMTP_USER with your Gmail address
#
# Alternative SMTP servers:
# Office 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587
# SendGrid:   SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587
# AWS SES:    SMTP_HOST=email-smtp.region.amazonaws.com, SMTP_PORT=587
