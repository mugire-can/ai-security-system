# ============================================================
# AI Security Camera System — environment configuration
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.
# ============================================================

# ------------------------------------------------------------------
# Venue
# ------------------------------------------------------------------
VENUE_TYPE=school           # school | commercial | workplace
VENUE_NAME="My Venue"

# ------------------------------------------------------------------
# Camera / detection
# ------------------------------------------------------------------
# YOLO model weights file (downloaded automatically on first run)
YOLO_MODEL=yolov8n.pt
# Frame sub-sampling for heavy analysis (face-recognition / emotion)
# Every N-th frame is analysed.  Higher = faster, less accurate.
# ANALYSIS_FRAME_INTERVAL=5

# ------------------------------------------------------------------
# Attendance
# ------------------------------------------------------------------
KNOWN_FACES_DIR=data/known_faces
WORK_START_TIME=08:00
WORK_END_TIME=18:00
REPORTS_DIR=data/reports

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# SQLite (default, no setup required):
DATABASE_URL=sqlite:///data/security_system.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/security_db

# ------------------------------------------------------------------
# Admin notifications
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com

# SMTP (email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-app-password-here

# Webhook (Slack / Teams / custom endpoint)
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------
DEBUG=false
